# ============================================================
# Matrix Event Management — Environment Variables
# ============================================================

# ── Supabase / PostgreSQL ──────────────────────────────────
# Get from: Supabase Project → Settings → Database → Connection string
# Use "Transaction" mode URL (port 6543) for DATABASE_URL (runtime queries via pgBouncer)
# Use "Session" mode URL (port 5432) for DIRECT_URL (prisma migrate / prisma studio)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Better Auth ────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Matrix Event Management"

# ── Email (Optional - for forgot password) ─────────────────
# Uncomment and fill in to enable real email sending
# EMAIL_FROM="noreply@yourdomain.com"
# RESEND_API_KEY="re_..."
